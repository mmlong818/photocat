{
  "productName": "猫叔的图",
  "version": "0.3.1",
  "identifier": "com.maoshu.photos",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../src-vite build",
    "beforeDevCommand": "pnpm --dir ../src-vite dev",
    "devUrl": "http://localhost:3580",
    "frontendDist": "../src-vite/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$PICTURES/**",
          "$VIDEOS/**",
          "$DOCUMENT/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**",
          "$APPCACHE/**",
          "/Volumes/**",
          "/media/**",
          "/mnt/**",
          "/run/media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Graphics and Design",
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "jfif"],
        "name": "JPEG Image",
        "description": "JPEG Image",
        "mimeType": "image/jpeg",
        "role": "Viewer"
      },
      {
        "ext": ["png"],
        "name": "PNG Image",
        "description": "PNG Image",
        "mimeType": "image/png",
        "role": "Viewer"
      },
      {
        "ext": ["gif"],
        "name": "GIF Image",
        "description": "GIF Image",
        "mimeType": "image/gif",
        "role": "Viewer"
      },
      {
        "ext": ["bmp"],
        "name": "Bitmap Image",
        "description": "Bitmap Image",
        "mimeType": "image/bmp",
        "role": "Viewer"
      },
      {
        "ext": ["webp"],
        "name": "WebP Image",
        "description": "WebP Image",
        "mimeType": "image/webp",
        "role": "Viewer"
      },
      {
        "ext": ["tif", "tiff"],
        "name": "TIFF Image",
        "description": "TIFF Image",
        "mimeType": "image/tiff",
        "role": "Viewer"
      },
      {
        "ext": ["avif"],
        "name": "AVIF Image",
        "description": "AVIF Image",
        "mimeType": "image/avif",
        "role": "Viewer"
      },
      {
        "ext": ["heic", "heif", "hif"],
        "name": "HEIF Image",
        "description": "HEIF Image",
        "mimeType": "image/heif",
        "role": "Viewer"
      },
      {
        "ext": ["jxl"],
        "name": "JPEG XL Image",
        "description": "JPEG XL Image",
        "mimeType": "image/jxl",
        "role": "Viewer"
      },
      {
        "ext": ["ico"],
        "name": "Icon Image",
        "description": "Windows Icon",
        "mimeType": "image/x-icon",
        "role": "Viewer"
      },
      {
        "ext": ["psd", "exr", "hdr", "tga", "dds", "qoi", "jp2", "j2k", "dpx", "fits"],
        "name": "Image",
        "description": "Image",
        "role": "Viewer"
      },
      {
        "ext": ["cr2", "cr3", "nef", "arw", "raf", "rw2", "orf", "pef", "dng", "srw", "rwl", "3fr", "iiq"],
        "name": "Camera RAW Image",
        "description": "Camera RAW Image",
        "role": "Viewer"
      }
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/models/*": "models",
      "resources/ffmpeg/*": "ffmpeg"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://REPLACE-WITH-YOUR-OWN-HOST/lap/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzMEQ0QzM2RTRDOUNEMjUKUldRbHpjbmtOa3dOVXlBYm0rYk9lY2FtVGpzWTJ2NkRqdUtSOEN4eUxwRlVTaUlVbkJ4aHhQS3gK"
    }
  }
}
